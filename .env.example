# --- Single-tenant / local dev mode (mcp_server.py, freshdesk_client.py) ---
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=

# --- OAuth 2.1 authorization server mode (oauth_server.py) ---
# This connector acts as its own OAuth provider — Claude/ChatGPT "Connect
# account" to THIS service, not directly to Freshdesk. Each connected user
# first signs up / logs in with a hub account (email + password, src/auth.py)
# and then enters their own Freshdesk domain + API key at the consent
# screen, so no FRESHDESK_DOMAIN/FRESHDESK_API_KEY above is needed for this
# mode. No extra env vars are needed for the hub login itself — it reuses
# MONGO_URI below.
MONGO_URI=mongodb://localhost:27017
# This server's own public URL once deployed — used in OAuth discovery
# metadata and must match what you tell MCP clients to connect to. No
# trailing slash.
OAUTH_BASE_URL=http://localhost:8004

# Envelope encryption key for connections.credentials_enc (src/vault.py) —
# 32 raw bytes, base64-encoded. Generate one with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=

# --- Upstream provider OAuth apps (src/connect_oauth.py) ---
# Each pair is optional — a provider's "Connect" button only appears once
# its CLIENT_ID is set (src/connected_accounts.py checks this). Redirect URI
# to register with each provider: {OAUTH_BASE_URL}/connect/{provider}/callback
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=

SALESLOFT_CLIENT_ID=
SALESLOFT_CLIENT_SECRET=
