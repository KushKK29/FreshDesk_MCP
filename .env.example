# --- Single-tenant / local dev mode (mcp_server.py, freshdesk_client.py) ---
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=

# --- OAuth 2.1 authorization server mode (oauth_server.py) ---
# This connector acts as its own OAuth provider — Claude/ChatGPT "Connect
# account" to THIS service, not directly to Freshdesk. Each connected user
# enters their own Freshdesk domain + API key at the consent screen, so no
# FRESHDESK_DOMAIN/FRESHDESK_API_KEY above is needed for this mode.
MONGO_URI=mongodb://localhost:27017
# This server's own public URL once deployed — used in OAuth discovery
# metadata and must match what you tell MCP clients to connect to.
OAUTH_BASE_URL=http://localhost:8004
